# 이 파일을 .env 로 복사해 값을 채웁니다. .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.
# 값에는 따옴표와 공백을 넣지 않습니다. 비워 둔 키는 해당 데이터만 건너뜁니다.

# --- 공공데이터포털 (data.go.kr) -------------------------------------------
# 계정당 일반 인증키 1개가 보통 모든 API에 쓰이고, API마다 활용신청만 따로 합니다.
# 아래 키들이 모두 같은 값이면 한 곳만 채우고 나머지는 비워 두세요 (비우면 DATA_GO_KR_KEY 를 씁니다).
DATA_GO_KR_KEY=
# 소상공인시장진흥공단 상가(상권)정보 15083033
SBIZ_STORE_KEY=
# [개발계정] 공정거래위원회 가맹정보 브랜드 가맹점 인테리어 비용정보 제공 서비스
FTC_FRANCHISE_INTERIOR_KEY=
# [개발계정] 공정거래위원회 가맹정보 브랜드 목록 정보 제공 서비스 (data.go.kr 15125467)
# 용도: 카페·고깃집·옷가게 가맹 브랜드의 브랜드관리번호를 받아, 인테리어 비용 API(15125479)로 업종별 평당 인테리어비를 계산한다
# 같은 공공데이터포털 계정이면 키가 같으므로 비워 두면 FTC_FRANCHISE_INTERIOR_KEY 를 같이 쓴다
FTC_BRAND_LIST_KEY=
# 축산물품질평가원 축산물 경락가격정보 (돼지고기 경락가격)
LIVESTOCK_AUCTION_KEY=
# 창업진흥원 K-Startup 사업공고 조회서비스 (예비창업자 지원사업 공고)
KSTARTUP_API_KEY=
# 강원도 축산물 가격 동향
GANGWON_LIVESTOCK_KEY=
# 기상청 지상(종관, ASOS) 시간자료 조회서비스 (개발계정)
ASOS_HOURLY_KEY=

# --- 그 밖의 기관 ----------------------------------------------------------
# 한국부동산원 R-ONE 상업용부동산 임대동향
RONE_KEY=
# 서울 열린데이터광장 (상권분석서비스 등)
SEOUL_OPEN_DATA_KEY=
# 기상청 API허브 (apihub.kma.go.kr)
KMA_APIHUB_KEY=
# KOSIS 국가통계포털 (외식물가)
KOSIS_KEY=
# KAMIS 농산물유통정보 (www.kamis.or.kr, 채소·곡물 소매가격). CERT_ID는 KAMIS 가입 ID
KAMIS_API_KEY=
KAMIS_CERT_ID=
# 한국은행 ECOS (ecos.bok.or.kr, 기준금리·예금은행 대출금리)
ECOS_API_KEY=

# --- 소상공인365 (bigdata.sbiz.or.kr, 오픈API) ------------------------------
# API마다 인증키가 따로 나옵니다. 받은 키를 이름에 맞춰 넣으세요. 값에 따옴표·공백 없이.
# 1. SNS 분석
SBIZ365_SNS_KEY=
# 2. 간단분석
SBIZ365_SIMPLE_KEY=
# 3. 경쟁분석
SBIZ365_COMPETITION_KEY=
# 4. 관광 축제 정보
SBIZ365_FESTIVAL_KEY=
# 5. 배달분석
SBIZ365_DELIVERY_KEY=
# 6. 상권지도
SBIZ365_MAP_KEY=
# 7. 상세분석
SBIZ365_DETAIL_KEY=
# 8. 주요통계
SBIZ365_MAIN_STATS_KEY=
# 9. 인구통계
SBIZ365_POPULATION_KEY=
# 10. 업소통계
SBIZ365_STORE_STATS_KEY=
# 11. 테마상권 분석
SBIZ365_THEME_KEY=
# 12. 입지분석
SBIZ365_LOCATION_KEY=
# 13. 업종분석
SBIZ365_INDUSTRY_KEY=
# 14. 매출통계
SBIZ365_SALES_KEY=
