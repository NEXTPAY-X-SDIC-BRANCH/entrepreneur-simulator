# 이 파일을 .env 로 복사해 값을 채웁니다. .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.
# 값에는 따옴표와 공백을 넣지 않습니다. 비워 둔 키는 해당 데이터만 건너뜁니다.

# --- 공공데이터포털 (data.go.kr) -------------------------------------------
# 계정당 일반 인증키 1개가 보통 모든 API에 쓰이고, API마다 활용신청만 따로 합니다.
# 아래 키들이 모두 같은 값이면 한 곳만 채우고 나머지는 비워 두세요 (비우면 DATA_GO_KR_KEY 를 씁니다).
DATA_GO_KR_KEY=
# 소상공인시장진흥공단 상가(상권)정보 15083033
SBIZ_STORE_KEY=
# 축산물품질평가원 축산물 경락가격정보 (돼지고기 경락가격)
LIVESTOCK_AUCTION_KEY=
# 강원도 축산물 가격 동향
GANGWON_LIVESTOCK_KEY=
# 기상청 지상(종관, ASOS) 시간자료 조회서비스 (개발계정)
ASOS_HOURLY_KEY=

# --- 그 밖의 기관 ----------------------------------------------------------
# 한국부동산원 R-ONE 상업용부동산 임대동향
RONE_KEY=
# 서울 열린데이터광장 (상권분석서비스 등)
SEOUL_OPEN_DATA_KEY=
# 기상청 API허브 (apihub.kma.go.kr)
KMA_APIHUB_KEY=
# KOSIS 국가통계포털 (외식물가)
KOSIS_KEY=
# KAMIS 농산물유통정보 (www.kamis.or.kr, 채소·곡물 소매가격). CERT_ID는 KAMIS 가입 ID
KAMIS_API_KEY=
KAMIS_CERT_ID=
